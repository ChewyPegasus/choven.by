# Production settings for compose.prod.yaml.
#   cp .env.prod.example .env.prod.local   (never commit the copy)
#   make prod-build prod-up

# Long random string: php -r 'echo bin2hex(random_bytes(32));'
APP_SECRET=
DEFAULT_URI=https://choven.by

POSTGRES_DB=choven
POSTGRES_USER=choven
POSTGRES_PASSWORD=

# SMTP of your mail provider, e.g. smtp://user:password@smtp.yandex.ru:465 or a Mailgun/Brevo/SES DSN
MAILER_DSN=
MAILER_FROM="Choven.by <info@choven.by>"

# Web server (FrankenPHP/Caddy, docker/frankenphp/Caddyfile).
# Leave SERVER_NAME empty (= ":80") to serve plain HTTP on HTTP_PORT behind your own TLS proxy.
# Set it to the domain(s) to let Caddy obtain Let's Encrypt certificates itself (ports 80 and 443 must be open):
#   SERVER_NAME="choven.by, www.choven.by"
SERVER_NAME=
HTTP_PORT=80
HTTPS_PORT=443
# PHP workers (each keeps its own database connection) and requests per worker before it is restarted.
FRANKENPHP_WORKERS=4
FRANKENPHP_LOOP_MAX=500

# Proxies whose X-Forwarded-For/-Proto/-Port are believed. private_ranges covers a TLS proxy on the same host or
# private network; add the public IP ranges of an external proxy (Cloudflare etc.) if you use one.
# Nothing in front (Caddy serves HTTPS itself): set 127.0.0.1 so that forwarded headers are never trusted.
TRUSTED_PROXIES=private_ranges
# Allowed host names (regular expressions, comma separated). Requests for other hosts get HTTP 400.
TRUSTED_HOSTS=^choven\.by$,^www\.choven\.by$

# Initial values of settings that admins can change later in Admin → Settings
CONTACT_PHONE="+375 29 706-75-85"
CONTACT_EMAIL=info@choven.by
CONTACT_INSTAGRAM=sergei_shpoka
CONTACT_TELEGRAM=
ADMIN_EMAIL=
BOOKING_DAILY_CAPACITY=60

# Optional: Telegram bot that posts new bookings, cancellations, call requests and reviews to the team chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

IMAGE_TAG=latest
