# Default configuration, committed to the repository and safe for local development.
#
# Real values for a server go to .env.local (not committed) or to real environment variables,
# which always take precedence. Production also supports `composer dump-env prod`.
#
# Load order: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-in-env-local-0f3c9a1e7b2d4c58a6e1
###< symfony/framework-bundle ###

# Absolute URL of the site; used in emails, the sitemap and console commands.
DEFAULT_URI=http://localhost:8080

# Comma separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (nginx, load balancer).
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

###> doctrine/doctrine-bundle ###
# Docker Compose publishes PostgreSQL on localhost:5432 (see compose.yaml).
DATABASE_URL="postgresql://choven:choven@127.0.0.1:5432/choven?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Emails are queued here and sent by the worker (`make worker` or the "worker" container).
# Use sync:// to send emails immediately during the request (handy without a worker).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit from compose.yaml catches all emails: http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM="Choven.by <info@choven.by>"
###< symfony/mailer ###

###> sessions & cache ###
# file://… keeps sessions on disk; redis://host:6379 is used in Docker / production.
SESSION_DSN=file://%kernel.project_dir%/var/sessions/%kernel.environment%
REDIS_URL=redis://127.0.0.1:6379
###< sessions & cache ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/debug-bundle ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug-bundle ###

###> app ###
# Defaults for settings that administrators can change later in Admin → Settings.
CONTACT_PHONE="+375 29 706-75-85"
CONTACT_EMAIL=info@choven.by
CONTACT_INSTAGRAM=sergei_shpoka
CONTACT_TELEGRAM=
# Where notifications about new bookings, requests and reviews are sent (defaults to CONTACT_EMAIL).
ADMIN_EMAIL=
# Max people on the water per day; 0 disables the capacity check.
BOOKING_DAILY_CAPACITY=60
# Optional Telegram notifications for the team: create a bot with @BotFather, add it to the team chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
###< app ###
