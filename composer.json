{
    "name": "choven/choven.by",
    "description": "Choven.by — booking platform for kayaking and rafting trips on Belarusian rivers",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "bacon/bacon-qr-code": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.5",
        "dompdf/dompdf": "^3.1",
        "dragonmantank/cron-expression": "^3.4",
        "giggsey/libphonenumber-for-php": "^9.0.41",
        "league/commonmark": "^2.10",
        "predis/predis": "^3.7",
        "scheb/2fa-backup-code": "^7.14",
        "scheb/2fa-bundle": "^7.14",
        "scheb/2fa-totp": "^7.14",
        "scheb/2fa-trusted-device": "^7.14",
        "sentry/sentry-symfony": "^5.14",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-turbo": "^2.36",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/reset-password-bundle": "^1.25",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^3.29",
        "twig/intl-extra": "^3.30",
        "twig/string-extra": "^3.0",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-doctrine": "^2.0.28",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.5.57",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.27"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:twig templates",
            "@php bin/console lint:yaml config translations --parse-tags",
            "@php bin/console doctrine:schema:validate --skip-sync"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false
        }
    }
}
