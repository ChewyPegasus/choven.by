{% extends 'base.html.twig' %}

{% block title %}{{ 'registration.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-card" style="max-width: 560px">
            <div class="card">
                <div class="auth-icon"><i class="fa-solid fa-user-plus"></i></div>
                <h1>{{ 'registration.title'|trans }}</h1>
                <p class="lead">{{ 'registration.subtitle'|trans }}</p>

                {{ form_start(form) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.phone) }}
                    <div data-controller="password-toggle" data-password-toggle-show-value="{{ 'a11y.show_password'|trans }}" data-password-toggle-hide-value="{{ 'a11y.hide_password'|trans }}">
                        {{ form_row(form.plainPassword.first) }}
                    </div>
                    {{ form_row(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword) }}
                    {{ form_row(form.agreeTerms, {label_translation_parameters: {'%privacy%': path('app_privacy'), '%terms%': path('app_terms')}}) }}
                    {{ form_row(form.marketingConsent) }}
                    {{ form_rest(form) }}
                    <button type="submit" class="btn btn-block btn-lg">{{ 'registration.submit'|trans }}</button>
                {{ form_end(form) }}

                <p class="form-footer">{{ 'registration.have_account'|trans }} <a href="{{ path('app_login') }}">{{ 'registration.login'|trans }}</a></p>
            </div>
        </div>
    </section>
{% endblock %}
