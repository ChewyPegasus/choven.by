{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.security'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    {% set user = app.user %}
    <section class="page-head">
        <div class="container">
            <h1>{{ 'nav.security'|trans }}</h1>
            <p>{{ user.email }}</p>
        </div>
    </section>

    <section class="section" style="padding-top: 0">
        <div class="container container-narrow">
            {% include 'profile/_nav.html.twig' %}

            <div class="card" id="two-factor">
                <h2 class="card-title"><i class="fa-solid fa-shield-halved"></i> {{ 'twofa.title'|trans }}</h2>

                {% if backup_codes is not empty %}
                    <div class="alert alert-warning mb-2">
                        <i class="fa-solid fa-key"></i>
                        <div>
                            <p class="fw-bold mb-1">{{ 'twofa.backup.save'|trans }}</p>
                            <ul class="backup-codes">
                                {% for code in backup_codes|first|split(' ') %}<li><code>{{ code }}</code></li>{% endfor %}
                            </ul>
                            <p class="text-small mb-0">{{ 'twofa.backup.hint'|trans }}</p>
                        </div>
                    </div>
                {% endif %}

                {% if user.totpAuthenticationEnabled %}
                    <p class="text-success"><i class="fa-solid fa-circle-check"></i> {{ 'twofa.enabled'|trans }}</p>
                    <p class="text-small text-muted">{{ 'twofa.backup.left'|trans({'%count%': user.countBackupCodes}) }}</p>
                    <div class="cluster">
                        <form method="post" action="{{ path('app_profile_2fa_backup_codes') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('2fa-backup') }}">
                            <button type="submit" class="btn btn-sm btn-outline"><i class="fa-solid fa-rotate"></i> {{ 'twofa.backup.regenerate'|trans }}</button>
                        </form>
                        <form method="post" action="{{ path('app_profile_forget_devices') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('forget-devices') }}">
                            <button type="submit" class="btn btn-sm btn-outline"><i class="fa-solid fa-laptop"></i> {{ 'twofa.forget_devices'|trans }}</button>
                        </form>
                    </div>
                    <details class="mt-3">
                        <summary class="text-danger">{{ 'twofa.disable'|trans }}</summary>
                        <form method="post" action="{{ path('app_profile_2fa_disable') }}" class="mt-2" data-turbo-confirm="{{ 'twofa.disable_confirm'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('2fa-disable') }}">
                            <div class="form-group">
                                <label class="form-label required" for="disable_password">{{ 'profile.password.current'|trans }}</label>
                                <input type="password" id="disable_password" name="password" class="form-control" autocomplete="current-password" required>
                            </div>
                            <button type="submit" class="btn btn-sm btn-danger">{{ 'twofa.disable'|trans }}</button>
                        </form>
                    </details>
                {% elseif setup %}
                    <ol class="setup-steps">
                        <li>{{ 'twofa.setup.step1'|trans }}</li>
                        <li>
                            {{ 'twofa.setup.step2'|trans }}
                            <div class="qr-box">
                                <img src="{{ qr_code }}" alt="{{ 'twofa.setup.qr_alt'|trans }}" width="220" height="220">
                                <div>
                                    <div class="text-small text-muted">{{ 'twofa.setup.manual'|trans }}</div>
                                    <code class="secret">{{ user.totpSecret|split('', 4)|join(' ') }}</code>
                                </div>
                            </div>
                        </li>
                        <li>
                            {{ 'twofa.setup.step3'|trans }}
                            <form method="post" action="{{ path('app_profile_2fa_confirm') }}" class="inline-form mt-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('2fa-confirm') }}">
                                <input type="text" name="code" class="form-control" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="123456" required aria-label="{{ 'twofa.code'|trans }}">
                                <button type="submit" class="btn">{{ 'twofa.setup.confirm'|trans }}</button>
                            </form>
                        </li>
                    </ol>
                {% else %}
                    <p class="text-muted">{{ 'twofa.intro'|trans }}</p>
                    <form method="post" action="{{ path('app_profile_2fa_start') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('2fa-start') }}">
                        <button type="submit" class="btn"><i class="fa-solid fa-mobile-screen"></i> {{ 'twofa.start'|trans }}</button>
                    </form>
                {% endif %}
            </div>

            <div class="card" id="messengers">
                <h2 class="card-title"><i class="fa-regular fa-bell"></i> {{ 'messenger.title'|trans }}</h2>
                <p class="text-muted">{{ 'messenger.account_text'|trans }}</p>
                {% if subscriptions is not empty %}
                    <ul class="plain-list mb-2">
                        {% for subscription in subscriptions %}
                            <li class="cluster" style="justify-content: space-between">
                                <span><i class="fa-brands fa-{{ subscription.channel.value }}"></i> {{ subscription.channel.label }}{% if subscription.displayName %} — {{ subscription.displayName }}{% endif %}</span>
                                <form method="post" action="{{ path('app_profile_messenger_disconnect', {id: subscription.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('disconnect-' ~ subscription.id) }}">
                                    <button type="submit" class="btn btn-sm btn-ghost text-danger">{{ 'messenger.disconnect'|trans }}</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if messengers.telegram or messengers.viber %}
                    <div class="cluster">
                        {% if messengers.telegram %}<a class="btn btn-outline btn-telegram" href="{{ messengers.telegram }}" target="_blank" rel="noopener"><i class="fa-brands fa-telegram"></i> Telegram</a>{% endif %}
                        {% if messengers.viber %}<a class="btn btn-outline btn-viber" href="{{ messengers.viber }}"><i class="fa-brands fa-viber"></i> Viber</a>{% endif %}
                    </div>
                {% else %}
                    <p class="text-small text-muted mb-0">{{ 'messenger.unavailable'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
