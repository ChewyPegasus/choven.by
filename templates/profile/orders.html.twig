{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.my_bookings'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="page-head">
        <div class="container">
            <h1>{{ 'profile.hello'|trans({'%name%': app.user.displayName}) }}</h1>
            <p>{{ 'profile.orders_subtitle'|trans }}</p>
        </div>
    </section>

    <section class="section" style="padding-top: 0">
        <div class="container container-narrow">
            {% include 'profile/_nav.html.twig' %}

            <div data-controller="tabs">
                <div class="tabs" role="tablist">
                    <button type="button" class="tab" role="tab" id="tab-upcoming" aria-controls="upcoming" aria-selected="true" data-tabs-target="tab" data-action="tabs#select">
                        {{ 'profile.upcoming'|trans }} <span class="badge">{{ upcoming|length }}</span>
                    </button>
                    <button type="button" class="tab" role="tab" id="tab-past" aria-controls="past" aria-selected="false" data-tabs-target="tab" data-action="tabs#select">
                        {{ 'profile.past'|trans }} <span class="badge">{{ past|length }}</span>
                    </button>
                </div>

                <div id="upcoming" role="tabpanel" aria-labelledby="tab-upcoming" data-tabs-target="panel" class="stack">
                    {% for order in upcoming %}
                        {% include 'profile/_order_card.html.twig' %}
                    {% else %}
                        <div class="empty">
                            <i class="fa-regular fa-calendar"></i>
                            <p>{{ 'profile.no_upcoming'|trans }}</p>
                            <a class="btn" href="{{ path('app_order_new') }}">{{ 'nav.book'|trans }}</a>
                        </div>
                    {% endfor %}
                </div>

                <div id="past" role="tabpanel" aria-labelledby="tab-past" data-tabs-target="panel" class="stack" hidden>
                    {% for order in past %}
                        {% include 'profile/_order_card.html.twig' %}
                    {% else %}
                        <div class="empty"><i class="fa-regular fa-folder-open"></i>{{ 'profile.no_past'|trans }}</div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
