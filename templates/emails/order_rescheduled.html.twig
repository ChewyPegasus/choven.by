{% extends 'emails/layout.html.twig' %}

{% block content %}
    {% set locale = order.locale %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.order_rescheduled.title'|trans({'%reference%': order.reference}) }}</h1>
    <p>{{ 'email.order_rescheduled.text'|trans({
        '%name%': order.name,
        '%old%': previous_start ? previous_start|format_date('long', locale: locale) : '—',
        '%new%': order.startDate|format_date('full', locale: locale),
    }) }}</p>
    {% include 'emails/_order_details.html.twig' %}
    {% include 'emails/_button.html.twig' with {href: order_url, label: 'email.order_confirmation.button'|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.order_rescheduled.calendar'|trans }}</p>
{% endblock %}
