{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.waitlist_joined.title'|trans({'%name%': entry.name}) }}</h1>
    <p>{{ 'email.waitlist_joined.text'|trans({
        '%date%': entry.startDate|format_date('full', locale: entry.locale),
        '%days%': 'tour.days'|trans({'%count%': entry.durationDays}),
        '%people%': 'profile.people'|trans({'%count%': entry.people}),
    }) }}</p>
    <p style="font-size:14px;color:#64748b;">{{ 'email.waitlist_joined.hint'|trans({'%phone%': settings.phone}) }}</p>
{% endblock %}
