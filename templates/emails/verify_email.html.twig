{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.verification.title'|trans({'%name%': user.displayName}) }}</h1>
    <p>{{ 'email.verification.text'|trans }}</p>
    {% include 'emails/_button.html.twig' with {href: signed_url, label: 'email.verification.button'|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.verification.expires'|trans({'%hours%': expires_in_hours}) }}</p>
    <p style="font-size:13px;color:#64748b;word-break:break-all;">{{ 'email.link_fallback'|trans }}<br><a href="{{ signed_url }}" style="color:#d95a00;">{{ signed_url }}</a></p>
    <p style="font-size:13px;color:#64748b;">{{ 'email.verification.ignore'|trans }}</p>
{% endblock %}
