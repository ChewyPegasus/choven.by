{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.order_confirmation.title'|trans({'%name%': order.name}) }}</h1>
    {% if order.depositDue > 0 %}
        <p>{{ (settings.prepaymentRequired ? 'email.order_confirmation.intro_prepayment_required' : 'email.order_confirmation.intro_prepayment')|trans({'%amount%': order.depositDue|byn, '%hours%': settings.prepaymentHoldHours}) }}</p>
    {% else %}
        <p>{{ 'email.order_confirmation.intro'|trans }}</p>
    {% endif %}
    {% include 'emails/_order_details.html.twig' %}
    {% include 'emails/_button.html.twig' with {href: order_url, label: (order.depositDue > 0 ? 'email.order_confirmation.button_pay' : 'email.order_confirmation.button')|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.order_confirmation.calendar'|trans }}</p>
    <p style="font-size:14px;color:#64748b;">{{ 'email.order_confirmation.cancel'|trans }}</p>
    <p style="margin-top:20px;">{{ 'email.order_confirmation.checklist'|trans }} <a href="{{ url('app_faq', {_locale: order.locale}) }}" style="color:#d95a00;">{{ 'email.order_confirmation.checklist_link'|trans }}</a></p>
{% endblock %}
