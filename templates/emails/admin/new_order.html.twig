{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:20px;color:#1b2a3a;">Новая бронь {{ order.reference }}</h1>
    <p>Заявка с сайта ({{ order.locale|upper }}). Свяжитесь с клиентом и подтвердите бронь в админке.</p>
    {% include 'emails/_order_details.html.twig' with {show_contacts: true, email_locale: 'ru'} %}
    {% if order.phoneE164 %}
        <p style="margin-top:16px;"><a href="tel:{{ order.phoneE164 }}" style="color:#d95a00;font-weight:bold;">Позвонить: {{ order.phoneFormatted }}</a></p>
    {% endif %}
    {% include 'emails/_button.html.twig' with {href: admin_url, label: 'Открыть в админке'} %}
{% endblock %}
