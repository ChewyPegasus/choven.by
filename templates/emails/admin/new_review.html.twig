{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:20px;color:#1b2a3a;">Новый отзыв ({{ review.rating }}/5) ждёт модерации</h1>
    <p style="font-size:22px;color:#f59e0b;margin:6px 0;">{% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}</p>
    <p><strong>{{ review.authorName }}</strong>{% if review.order %} · бронь {{ review.order.reference }}{% endif %}</p>
    <blockquote style="margin:0;padding:12px 16px;background:#f8fafc;border-left:4px solid #ff6b00;white-space:pre-line;">{{ review.text }}</blockquote>
    {% include 'emails/_button.html.twig' with {href: admin_url, label: 'Опубликовать или отклонить'} %}
{% endblock %}
