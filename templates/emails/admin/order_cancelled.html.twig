{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:20px;color:#1b2a3a;">Клиент отменил бронь {{ order.reference }}</h1>
    <p>Бронь отменена клиентом {{ order.cancelledAt ? order.cancelledAt|date('d.m.Y H:i') }}. Места на эти даты освободились.</p>
    {% include 'emails/_order_details.html.twig' with {show_contacts: true, email_locale: 'ru'} %}
    {% include 'emails/_button.html.twig' with {href: admin_url, label: 'Открыть в админке', color: '#1b2a3a'} %}
{% endblock %}
