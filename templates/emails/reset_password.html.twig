{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.password_reset.title'|trans }}</h1>
    <p>{{ 'email.password_reset.text'|trans }}</p>
    {% include 'emails/_button.html.twig' with {href: reset_url, label: 'email.password_reset.button'|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.password_reset.expires'|trans({'%time%': expires_at|date('d.m.Y H:i')}) }}</p>
    <p style="font-size:13px;color:#64748b;word-break:break-all;">{{ 'email.link_fallback'|trans }}<br><a href="{{ reset_url }}" style="color:#d95a00;">{{ reset_url }}</a></p>
    <p style="font-size:13px;color:#64748b;">{{ 'email.password_reset.ignore'|trans }}</p>
{% endblock %}
