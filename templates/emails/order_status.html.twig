{% extends 'emails/layout.html.twig' %}

{% block content %}
    {% set status = order.status.value %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ ('email.order_status.' ~ status ~ '.title')|trans({'%reference%': order.reference}) }}</h1>
    <p>{{ ('email.order_status.' ~ status ~ '.text')|trans({'%name%': order.name}) }}</p>
    {% include 'emails/_order_details.html.twig' %}
    {% include 'emails/_button.html.twig' with {href: order_url, label: 'email.order_confirmation.button'|trans, color: status == 'cancelled' ? '#1b2a3a' : '#ff6b00'} %}
    {% if status == 'cancelled' %}
        <p>{{ 'email.order_status.cancelled.rebook'|trans }} <a href="{{ url('app_order_new', {_locale: order.locale}) }}" style="color:#d95a00;">{{ 'nav.book'|trans }}</a></p>
    {% endif %}
{% endblock %}
