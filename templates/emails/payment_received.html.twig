{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.payment_received.title'|trans({'%name%': order.name}) }}</h1>
    <p>{{ 'email.payment_received.text'|trans({'%amount%': payment.amount|byn, '%reference%': order.reference}) }}</p>
    {% if order.status.value == 'confirmed' %}
        <p><strong>{{ 'email.payment_received.confirmed'|trans }}</strong></p>
    {% endif %}
    {% include 'emails/_order_details.html.twig' %}
    {% include 'emails/_button.html.twig' with {href: order_url, label: 'email.order_confirmation.button'|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.payment_received.receipt'|trans }}</p>
{% endblock %}
