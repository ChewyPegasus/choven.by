{% extends 'emails/layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 12px;font-size:22px;color:#1b2a3a;">{{ 'email.order_expired.title'|trans({'%reference%': order.reference}) }}</h1>
    <p>{{ 'email.order_expired.text'|trans({'%name%': order.name}) }}</p>
    {% include 'emails/_order_details.html.twig' %}
    {% include 'emails/_button.html.twig' with {href: rebook_url, label: 'email.order_expired.button'|trans} %}
    <p style="font-size:14px;color:#64748b;">{{ 'email.order_expired.contact'|trans({'%phone%': settings.phone}) }}</p>
{% endblock %}
