{% extends 'admin/layout.html.twig' %}

{% set is_new = extra.id is null %}
{% block title %}{{ is_new ? 'admin.extras.new'|trans : extra.name|localized }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div class="breadcrumbs"><a href="{{ path('app_admin_extras') }}">{{ 'admin.menu.extras'|trans }}</a> /</div>
        <h1>{{ is_new ? 'admin.extras.new'|trans : extra.name|localized }}</h1>
    </div>

    {{ form_start(form) }}
    <div class="admin-form-layout">
        <div class="card">
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}
        </div>
        <aside>
            <div class="card">
                <div class="form-row">
                    {{ form_row(form.price) }}
                    {{ form_row(form.unit) }}
                </div>
                {{ form_row(form.perDay) }}
                {{ form_row(form.maxQuantity) }}
                <div class="form-row">
                    {{ form_row(form.icon) }}
                    {{ form_row(form.position) }}
                </div>
                {{ form_row(form.isActive) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-block"><i class="fa-solid fa-floppy-disk"></i> {{ 'admin.common.save'|trans }}</button>
            </div>
        </aside>
    </div>
    {{ form_end(form) }}

    {% if not is_new %}
        <form method="post" action="{{ path('app_admin_extra_delete', {id: extra.id}) }}" class="mt-3" data-turbo-confirm="{{ 'admin.extras.delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-extra-' ~ extra.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost text-danger"><i class="fa-solid fa-trash"></i> {{ 'admin.common.delete'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
