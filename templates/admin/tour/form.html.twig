{% extends 'admin/layout.html.twig' %}

{% set is_new = tour.id is null %}
{% block title %}{{ is_new ? 'admin.tours.new'|trans : tour.title|localized }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div class="breadcrumbs"><a href="{{ path('app_admin_tours') }}">{{ 'admin.menu.tours'|trans }}</a> /</div>
        <h1>{{ is_new ? 'admin.tours.new'|trans : tour.title|localized }}</h1>
    </div>

    {{ form_start(form) }}
    <div class="admin-form-layout" data-controller="slug" data-slug-source-value="#{{ form.title.ru.vars.id }}">
        <div class="card">
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            {{ form_row(form.slug, {attr: {'data-slug-target': 'slug', 'data-action': 'slug#edited'}}) }}
            {{ form_row(form.summary) }}
            {{ form_row(form.description) }}
        </div>
        <aside>
            <div class="card">
                {% set image = image_url(tour.image) %}
                {% if image %}
                    <img src="{{ image }}" alt="" style="border-radius: 10px; margin-bottom: 12px">
                {% endif %}
                {{ form_row(form.imageFile) }}
                {{ form_row(form.package) }}
                {{ form_row(form.river) }}
                {{ form_row(form.route) }}
                <div class="form-row">
                    {{ form_row(form.durationDays) }}
                    {{ form_row(form.position) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.priceFrom) }}
                    {{ form_row(form.priceUnit) }}
                </div>
                {{ form_row(form.isActive) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-block"><i class="fa-solid fa-floppy-disk"></i> {{ 'admin.common.save'|trans }}</button>
            </div>
        </aside>
    </div>
    {{ form_end(form) }}

    {% if not is_new %}
        <form method="post" action="{{ path('app_admin_tour_delete', {id: tour.id}) }}" class="mt-3" data-turbo-confirm="{{ 'admin.tours.delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-tour-' ~ tour.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost text-danger"><i class="fa-solid fa-trash"></i> {{ 'admin.common.delete'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
