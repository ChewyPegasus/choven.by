{% extends 'admin/layout.html.twig' %}

{% set is_new = item.id is null %}
{% block title %}{{ is_new ? 'admin.faq.new'|trans : item.question|localized }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div class="breadcrumbs"><a href="{{ path('app_admin_faq') }}">{{ 'admin.menu.faq'|trans }}</a> /</div>
        <h1>{{ is_new ? 'admin.faq.new'|trans : item.question|localized }}</h1>
    </div>

    {{ form_start(form) }}
    <div class="admin-form-layout">
        <div class="card">
            {{ form_errors(form) }}
            {{ form_row(form.question) }}
            {{ form_row(form.answer) }}
        </div>
        <aside>
            <div class="card">
                {{ form_row(form.position) }}
                {{ form_row(form.showOnHome) }}
                {{ form_row(form.isActive) }}
                {{ form_rest(form) }}
                <button type="submit" class="btn btn-block"><i class="fa-solid fa-floppy-disk"></i> {{ 'admin.common.save'|trans }}</button>
            </div>
        </aside>
    </div>
    {{ form_end(form) }}

    {% if not is_new %}
        <form method="post" action="{{ path('app_admin_faq_delete', {id: item.id}) }}" class="mt-3" data-turbo-confirm="{{ 'admin.faq.delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-faq-' ~ item.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost text-danger"><i class="fa-solid fa-trash"></i> {{ 'admin.common.delete'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
