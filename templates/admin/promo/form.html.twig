{% extends 'admin/layout.html.twig' %}

{% set is_new = code.id is null %}
{% block title %}{{ is_new ? 'admin.promo.new'|trans : code.code }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div class="breadcrumbs"><a href="{{ path('app_admin_promo_codes') }}">{{ 'admin.menu.promo'|trans }}</a> /</div>
        <h1>{{ is_new ? 'admin.promo.new'|trans : code.code }}</h1>
    </div>

    <div class="card" style="max-width: 720px">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.code) }}
            <div class="form-row">
                {{ form_row(form.type) }}
                {{ form_row(form.value) }}
            </div>
            <div class="form-row form-row-3">
                {{ form_row(form.validFrom) }}
                {{ form_row(form.validUntil) }}
                {{ form_row(form.maxUses) }}
            </div>
            {{ form_row(form.note) }}
            {{ form_row(form.isActive) }}
            {{ form_rest(form) }}
            {% if not is_new %}<p class="text-small text-muted">{{ 'admin.promo.used_times'|trans({'%count%': code.usedCount}) }}</p>{% endif %}
            <button type="submit" class="btn"><i class="fa-solid fa-floppy-disk"></i> {{ 'admin.common.save'|trans }}</button>
        {{ form_end(form) }}
    </div>

    {% if not is_new %}
        <form method="post" action="{{ path('app_admin_promo_code_delete', {id: code.id}) }}" class="mt-3" data-turbo-confirm="{{ 'admin.promo.delete_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-promo-' ~ code.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost text-danger"><i class="fa-solid fa-trash"></i> {{ 'admin.common.delete'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
