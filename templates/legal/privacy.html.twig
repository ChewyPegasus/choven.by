{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.privacy.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'legal.privacy.description'|trans }}{% endblock %}

{% block body %}
    <section class="page-head">
        <div class="container container-narrow">
            <h1>{{ 'legal.privacy.title'|trans }}</h1>
            <p class="legal-meta">{{ 'legal.effective'|trans({'%date%': '08.07.2025', '%updated%': '22.10.2026'}) }}</p>
        </div>
    </section>
    <section class="section" style="padding-top: 0">
        <div class="container container-narrow prose">
            {% include 'legal/_privacy.' ~ (app.request.locale in ['ru', 'be', 'en'] ? app.request.locale : 'ru') ~ '.html.twig' %}
            <p class="mt-3"><a href="{{ asset('files/privacy_policy/Privacy_Policy.pdf') }}" download><i class="fa-solid fa-file-pdf"></i> {{ 'legal.download_pdf'|trans }}</a></p>
        </div>
    </section>
{% endblock %}
