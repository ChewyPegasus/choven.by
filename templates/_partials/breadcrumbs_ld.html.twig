{# schema.org BreadcrumbList; items: [{name: '…', url: '…'}, …] #}
{% set list = [] %}
{% for item in items %}
    {% set list = list|merge([{'@type': 'ListItem', position: loop.index, name: item.name, item: item.url}]) %}
{% endfor %}
<script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: list}|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
