{% extends 'base.html.twig' %}

{% block title %}{{ 'booking.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'booking.meta_description'|trans }}{% endblock %}

{% block body %}
    <section class="page-head">
        <div class="container">
            <h1>{{ 'booking.title'|trans }}</h1>
            <p>{{ 'booking.subtitle'|trans }}</p>
        </div>
    </section>

    <section class="section" style="padding-top: 0">
        <div class="container booking-layout"
             data-controller="booking"
             data-booking-availability-url-value="{{ path('app_booking_availability') }}"
             data-booking-price-value="{{ tour.priceFrom ?? 0 }}"
             data-booking-unit-value="{{ tour.priceUnit ?? 'person' }}"
             data-booking-labels-value="{{ {
                 available: 'booking.availability.available'|trans,
                 few: 'booking.availability.few'|trans,
                 notEnough: 'booking.availability.not_enough'|trans,
                 soldOut: 'booking.availability.sold_out'|trans,
                 blocked: 'booking.availability.blocked'|trans,
             }|json_encode }}">
            <div class="card">
                {{ form_start(form) }}
                    {{ form_errors(form) }}

                    <h2 class="form-section-title">{{ 'booking.section.trip'|trans }}</h2>
                    <div class="form-row">
                        <div>
                            {{ form_row(form.startDate) }}
                            <p class="availability" data-booking-target="availability" hidden aria-live="polite"></p>
                        </div>
                        {{ form_row(form.durationDays) }}
                    </div>
                    <div class="form-row form-row-3">
                        {{ form_row(form.amountOfPeople) }}
                        {{ form_row(form.river) }}
                        {{ form_row(form.package) }}
                    </div>

                    <h2 class="form-section-title mt-2">{{ 'booking.section.contacts'|trans }}</h2>
                    <div class="form-row">
                        {{ form_row(form.name) }}
                        {{ form_row(form.phone) }}
                    </div>
                    {{ form_row(form.email) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.agreeTerms, {label_translation_parameters: {'%privacy%': path('app_privacy'), '%terms%': path('app_terms')}}) }}
                    {{ form_rest(form) }}

                    <div class="form-actions">
                        <button type="submit" class="btn btn-lg"><i class="fa-solid fa-paper-plane"></i> {{ 'booking.submit'|trans }}</button>
                        <span class="text-small text-muted">{{ 'booking.no_prepayment'|trans }}</span>
                    </div>
                {{ form_end(form) }}
            </div>

            <aside class="booking-aside">
                <div class="card">
                    {% if tour %}
                        <div class="booking-tour">
                            {% set image = image_url(tour.image) %}
                            {% if image %}<img src="{{ image }}" alt="">{% else %}<div class="img-placeholder"><i class="fa-solid fa-water"></i></div>{% endif %}
                            <div>
                                <div class="text-small text-muted">{{ 'booking.selected_tour'|trans }}</div>
                                <h3>{{ tour.title|localized }}</h3>
                            </div>
                        </div>
                        {% if tour.priceFrom %}
                            <div class="text-small text-muted">{{ 'booking.estimate'|trans }}</div>
                            <div class="price-estimate" data-booking-target="price">{{ tour.estimatePrice(order.amountOfPeople ?? 1)|byn }}</div>
                            <p class="text-small text-muted">{{ 'booking.estimate_hint'|trans }}</p>
                        {% endif %}
                    {% else %}
                        <h3 class="card-title">{{ 'booking.how.title'|trans }}</h3>
                    {% endif %}
                    <ol class="text-small" style="padding-left: 18px; margin-bottom: 0">
                        <li>{{ 'booking.how.1'|trans }}</li>
                        <li>{{ 'booking.how.2'|trans }}</li>
                        <li>{{ 'booking.how.3'|trans }}</li>
                    </ol>
                </div>
                <div class="card card-muted">
                    <p class="fw-bold mb-1">{{ 'booking.prefer_phone'|trans }}</p>
                    <p class="mb-0"><i class="fa-solid fa-phone"></i> <a href="tel:{{ settings.phoneLink }}">{{ settings.phone }}</a></p>
                </div>
                {% if not app.user %}
                    <p class="text-small text-muted mt-2">{{ 'booking.login_hint'|trans({'%login%': path('app_login'), '%register%': path('app_register')})|raw }}</p>
                {% endif %}
            </aside>
        </div>
    </section>
{% endblock %}
