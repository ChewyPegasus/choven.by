{% extends 'base.html.twig' %}

{% block title %}{{ 'waitlist.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="section">
        <div class="container container-narrow">
            {% if form %}
                <h1>{{ 'waitlist.title'|trans }}</h1>
                <div class="card">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        <div class="form-row form-row-3">
                            {{ form_row(form.startDate) }}
                            {{ form_row(form.durationDays) }}
                            {{ form_row(form.people) }}
                        </div>
                        <div class="form-row form-row-3">
                            {{ form_row(form.name) }}
                            {{ form_row(form.email) }}
                            {{ form_row(form.phone) }}
                        </div>
                        {{ form_row(form.agreeTerms, {label_translation_parameters: {'%privacy%': path('app_privacy'), '%terms%': path('app_terms')}}) }}
                        {{ form_rest(form) }}
                        <button type="submit" class="btn btn-dark"><i class="fa-solid fa-bell"></i> {{ 'waitlist.submit'|trans }}</button>
                    {{ form_end(form) }}
                </div>
            {% else %}
                <div class="booking-hero">
                    <div class="icon-circle"><i class="fa-solid fa-bell"></i></div>
                    <h1>{{ (already ? 'waitlist.already' : 'waitlist.done')|trans }}</h1>
                    <p class="text-muted">{{ 'waitlist.done_text'|trans({'%date%': entry.startDate|format_date('long', locale: app.request.locale), '%email%': entry.email}) }}</p>
                    <div class="cluster" style="justify-content: center">
                        <a class="btn" href="{{ path('app_order_new') }}">{{ 'waitlist.other_date'|trans }}</a>
                        <a class="btn btn-outline" href="{{ path('app_main') }}">{{ 'error.home'|trans }}</a>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
