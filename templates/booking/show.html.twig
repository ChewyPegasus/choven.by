{% extends 'base.html.twig' %}

{% block title %}{{ 'booking.show.title'|trans({'%reference%': order.reference}) }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}
{# The URL contains the secret booking token: never send it to analytics. #}
{% block analytics %}{% endblock %}

{% block body %}
    {% set status = order.status.value %}
    <section class="section">
        <div class="container container-narrow">
            {% if just_created %}
                <div class="booking-hero">
                    <div class="icon-circle"><i class="fa-solid fa-check"></i></div>
                    <h1>{{ 'booking.show.thanks'|trans }}</h1>
                    <p class="text-muted">{{ 'booking.show.thanks_text'|trans({'%email%': order.email}) }}</p>
                </div>
            {% else %}
                <h1>{{ 'booking.show.heading'|trans }}</h1>
            {% endif %}

            <div class="card">
                <div class="cluster" style="justify-content: space-between">
                    <div>
                        <div class="text-small text-muted">{{ 'booking.show.reference'|trans }}</div>
                        <span class="booking-reference">
                            {{ order.reference }}
                            <button type="button" class="btn btn-ghost btn-sm" data-controller="clipboard"
                                    data-clipboard-text-value="{{ order.reference }}" data-clipboard-done-value="{{ 'booking.show.copied'|trans }}"
                                    data-action="clipboard#copy" aria-label="{{ 'booking.show.copy'|trans }}"><i class="fa-regular fa-copy"></i></button>
                        </span>
                    </div>
                    <span class="badge badge-status-{{ status }}">{{ order.status|trans }}</span>
                </div>

                {% if status != 'cancelled' %}
                    <ol class="status-track" aria-label="{{ 'booking.show.progress'|trans }}">
                        <li class="is-done">{{ 'order.status.new'|trans }}</li>
                        <li class="{{ status in ['confirmed', 'completed'] ? 'is-done' }}">{{ 'order.status.confirmed'|trans }}</li>
                        <li class="{{ status == 'completed' ? 'is-done' }}">{{ 'order.status.completed'|trans }}</li>
                    </ol>
                    <p class="text-small text-muted mt-2">{{ ('booking.show.status_hint.' ~ status)|trans }}</p>
                {% else %}
                    <div class="alert alert-warning mt-2"><i class="fa-solid fa-ban"></i><div>{{ 'booking.show.cancelled'|trans({'%date%': order.cancelledAt ? order.cancelledAt|format_date('long', locale: app.request.locale) : ''}) }}</div></div>
                {% endif %}

                <hr style="border: 0; border-top: 1px solid var(--c-line); margin: 20px 0">

                <dl class="dl">
                    <dt>{{ 'booking.form.start_date'|trans }}</dt>
                    <dd>
                        {{ order.startDate|format_date('full', locale: app.request.locale) }}
                        {% if order.durationDays > 1 %} — {{ order.endDate|format_date('long', locale: app.request.locale) }}{% endif %}
                    </dd>
                    <dt>{{ 'booking.show.duration'|trans }}</dt>
                    <dd>{{ 'tour.days'|trans({'%count%': order.durationDays}) }}</dd>
                    <dt>{{ 'booking.form.people'|trans }}</dt>
                    <dd>{{ order.amountOfPeople }}</dd>
                    {% if order.tour %}
                        <dt>{{ 'booking.selected_tour'|trans }}</dt>
                        <dd>{{ order.tour.title|localized }}</dd>
                    {% endif %}
                    <dt>{{ 'booking.form.river'|trans }}</dt>
                    <dd>{{ order.river|trans }}</dd>
                    <dt>{{ 'booking.form.package'|trans }}</dt>
                    <dd>{{ order.package|trans }}</dd>
                    <dt>{{ 'booking.form.name'|trans }}</dt>
                    <dd>{{ order.name }}</dd>
                    {% if order.phoneFormatted %}
                        <dt>{{ 'booking.form.phone'|trans }}</dt>
                        <dd>{{ order.phoneFormatted }}</dd>
                    {% endif %}
                    <dt>{{ 'booking.form.email'|trans }}</dt>
                    <dd>{{ order.email }}</dd>
                    {% if order.description %}
                        <dt>{{ 'booking.form.comment'|trans }}</dt>
                        <dd style="white-space: pre-line">{{ order.description }}</dd>
                    {% endif %}
                </dl>

                {% include '_partials/order_price.html.twig' %}

                {% if can_pay %}
                    <div class="pay-box mt-2">
                        <div>
                            <div class="fw-bold">{{ 'payment.due'|trans({'%amount%': order.depositDue|byn}) }}</div>
                            <div class="text-small text-muted">
                                {{ settings.prepaymentRequired and status == 'new'
                                    ? 'payment.due_required'|trans({'%time%': order.createdAt|date_modify('+' ~ settings.prepaymentHoldHours ~ ' hours')|format_datetime('short', 'short', locale: app.request.locale)})
                                    : 'payment.due_optional'|trans }}
                            </div>
                        </div>
                        <form method="post" action="{{ path('app_order_pay', {token: order.accessToken}) }}" data-turbo="false">
                            <input type="hidden" name="_token" value="{{ csrf_token('pay-order-' ~ order.id) }}">
                            <button type="submit" class="btn btn-lg"><i class="fa-solid fa-credit-card"></i> {{ 'payment.pay'|trans({'%amount%': order.depositDue|byn}) }}</button>
                        </form>
                    </div>
                {% endif %}

                {% if order.canBeCancelledByCustomer %}
                    {% set deadline = policy.freeChangeDeadline(order) %}
                    <p class="text-small text-muted mt-2 mb-0">
                        <i class="fa-solid fa-circle-info"></i>
                        {% if policy.withinFreePeriod(order) %}
                            {{ 'policy.free_until'|trans({'%date%': deadline|format_date('long', locale: app.request.locale)}) }}
                        {% else %}
                            {{ (order.paidAmount > 0 ? 'policy.late_paid' : 'policy.late')|trans }}
                        {% endif %}
                    </p>
                {% endif %}

                <div class="form-actions mt-3">
                    {% if status != 'cancelled' and order.upcoming %}
                        <a class="btn btn-outline" href="{{ path('app_order_ics', {token: order.accessToken}) }}" data-turbo="false"><i class="fa-regular fa-calendar-plus"></i> {{ 'booking.show.add_to_calendar'|trans }}</a>
                    {% endif %}
                    {% if policy.canReschedule(order) %}
                        <a class="btn btn-outline" href="{{ path('app_order_reschedule', {token: order.accessToken}) }}"><i class="fa-regular fa-calendar"></i> {{ 'reschedule.button'|trans }}</a>
                    {% endif %}
                    {% if order.canBeCancelledByCustomer %}
                        <form method="post" action="{{ path('app_order_cancel', {token: order.accessToken}) }}" data-turbo-confirm="{{ (policy.refundable(order) ? 'booking.show.cancel_confirm_refund' : (order.paidAmount > 0 ? 'booking.show.cancel_confirm_no_refund' : 'booking.show.cancel_confirm'))|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel-order-' ~ order.id) }}">
                            <button type="submit" class="btn btn-ghost text-danger"><i class="fa-solid fa-xmark"></i> {{ 'booking.show.cancel'|trans }}</button>
                        </form>
                    {% endif %}
                    {% if status == 'completed' and review is null %}
                        <a class="btn" href="{{ path('app_review_new', {token: order.accessToken}) }}"><i class="fa-regular fa-star"></i> {{ 'review.leave'|trans }}</a>
                    {% endif %}
                </div>
            </div>

            {% if forecast is not empty %}
                <div class="card">
                    <h2 class="card-title"><i class="fa-solid fa-cloud-sun"></i> {{ 'weather.title'|trans }}</h2>
                    {% include '_partials/forecast.html.twig' %}
                </div>
            {% endif %}

            {% if status in ['new', 'confirmed'] and order.upcoming and (messengers.telegram or messengers.viber) %}
                <div class="card">
                    <h2 class="card-title"><i class="fa-regular fa-bell"></i> {{ 'messenger.title'|trans }}</h2>
                    {% if messengers.connected is not empty %}
                        <p class="text-success mb-2"><i class="fa-solid fa-check"></i> {{ 'messenger.connected'|trans({'%channels%': messengers.connected|join(', ')}) }}</p>
                    {% else %}
                        <p class="text-muted">{{ 'messenger.text'|trans }}</p>
                    {% endif %}
                    <div class="cluster">
                        {% if messengers.telegram %}
                            <a class="btn btn-outline btn-telegram" href="{{ messengers.telegram }}" target="_blank" rel="noopener"><i class="fa-brands fa-telegram"></i> Telegram</a>
                        {% endif %}
                        {% if messengers.viber %}
                            <a class="btn btn-outline btn-viber" href="{{ messengers.viber }}"><i class="fa-brands fa-viber"></i> Viber</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if review %}
                <div class="card">
                    <h2 class="card-title">{{ 'review.yours'|trans }}</h2>
                    {% include '_partials/stars.html.twig' with {rating: review.rating} %}
                    <p class="mt-1">{{ review.text|nl2br }}</p>
                    <span class="badge badge-status-{{ review.status.value }}">{{ review.status|trans }}</span>
                </div>
            {% endif %}

            <div class="card card-muted">
                <p class="mb-1 fw-bold">{{ 'booking.show.questions'|trans }}</p>
                <p class="mb-0">
                    <i class="fa-solid fa-phone"></i> <a href="tel:{{ settings.phoneLink }}">{{ settings.phone }}</a>
                    &nbsp;·&nbsp; <i class="fa-solid fa-envelope"></i> <a href="mailto:{{ settings.email }}?subject={{ order.reference|url_encode }}">{{ settings.email }}</a>
                </p>
            </div>

            <p class="text-center mt-3">
                {% if app.user %}
                    <a href="{{ path('app_profile_orders') }}">← {{ 'nav.my_bookings'|trans }}</a>
                {% else %}
                    <span class="text-small text-muted">{{ 'booking.show.bookmark'|trans }}</span>
                {% endif %}
            </p>
        </div>
    </section>
{% endblock %}
