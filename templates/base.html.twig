<!DOCTYPE html>
{%- set locale = app.request.locale -%}
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{% block title %}{{ 'seo.default_title'|trans }}{% endblock %}{% block title_suffix %} — {{ site_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ 'seo.default_description'|trans }}{% endblock %}">
    {%- block robots %}{% endblock %}
    <meta name="theme-color" content="#1b2a3a">

    {%- set current_route = app.request.attributes.get('_route') -%}
    {%- if current_route and app.request.attributes.get('_route_params')._locale is defined and block('robots') is empty %}
        <link rel="canonical" href="{{ locale_url(locale, true) }}">
        {%- for l in supported_locales() %}
        <link rel="alternate" hreflang="{{ l }}" href="{{ locale_url(l, true) }}">
        {%- endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ url('app_root') }}">
    {%- endif %}

    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{{ block('title')|striptags|trim }}">
    <meta property="og:description" content="{{ block('meta_description')|striptags|trim }}">
    <meta property="og:locale" content="{{ {'ru': 'ru_RU', 'be': 'be_BY', 'en': 'en_US'}[locale] ?? 'ru_RU' }}">
    {%- block og_image %}
        {%- if asset_exists('images/og-image.jpg') %}
        <meta property="og:image" content="{{ absolute_url(asset('images/og-image.jpg')) }}">
        {%- endif %}
    {%- endblock %}

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer">

    {% block stylesheets %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% block structured_data %}{% endblock %}
    {% block analytics %}
        {% if settings.hasAnalytics and not is_granted('ROLE_ADMIN') and app.environment == 'prod' %}
            {% include '_partials/analytics.html.twig' %}
        {% endif %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip-link" href="#main">{{ 'a11y.skip_to_content'|trans }}</a>

    {% set announcement = settings.announcement(locale) %}
    {% if announcement %}
        <div class="announcement" role="status">{{ announcement }}</div>
    {% endif %}

    {% block header %}{% include '_partials/header.html.twig' %}{% endblock %}

    {% if app.request.hasPreviousSession %}
        {% include '_partials/flashes.html.twig' %}
    {% endif %}

    <main id="main" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}{% include '_partials/footer.html.twig' %}{% endblock %}
</body>
</html>
