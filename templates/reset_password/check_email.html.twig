{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.check_email.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-card">
            <div class="card text-center">
                <div class="auth-icon"><i class="fa-regular fa-envelope-open"></i></div>
                <h1>{{ 'reset_password.check_email.title'|trans }}</h1>
                <p>{{ 'reset_password.check_email.text'|trans({'%expires%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>
                <p class="text-small text-muted">{{ 'registration.check_email.spam'|trans }}</p>
                <a class="btn btn-outline" href="{{ path('app_forgot_password_request') }}">{{ 'reset_password.check_email.retry'|trans }}</a>
            </div>
        </div>
    </section>
{% endblock %}
