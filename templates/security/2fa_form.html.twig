{% extends 'base.html.twig' %}

{% block title %}{{ 'twofa.login.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-card">
            <div class="card">
                <div class="auth-icon"><i class="fa-solid fa-shield-halved"></i></div>
                <h1>{{ 'twofa.login.title'|trans }}</h1>
                <p class="lead">{{ 'twofa.login.text'|trans }}</p>

                {% if authenticationError %}
                    <div class="alert alert-error mb-2" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <div>{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>
                    </div>
                {% endif %}

                <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}">
                    <div class="form-group">
                        <label class="form-label required" for="_auth_code">{{ 'twofa.code'|trans }}</label>
                        <input type="text" id="_auth_code" name="{{ authCodeParameterName }}" class="form-control otp-input"
                               autocomplete="one-time-code" inputmode="text" autofocus required maxlength="9" spellcheck="false" autocapitalize="none">
                        <small class="form-help">{{ 'twofa.login.backup_hint'|trans }}</small>
                    </div>
                    {% if displayTrustedOption %}
                        <div class="form-check mb-2">
                            <input type="checkbox" id="_trusted" name="{{ trustedParameterName }}" class="form-check-input">
                            <label for="_trusted" class="form-check-label">{{ 'twofa.login.trust'|trans }}</label>
                        </div>
                    {% endif %}
                    {% if isCsrfProtectionEnabled %}
                        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                    {% endif %}
                    <button type="submit" class="btn btn-block btn-lg">{{ 'twofa.login.submit'|trans }}</button>
                </form>

                <form method="post" action="{{ path('app_logout') }}" class="form-footer">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="link-button">{{ 'twofa.login.cancel'|trans }}</button>
                </form>
            </div>
        </div>
    </section>
{% endblock %}
