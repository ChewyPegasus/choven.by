{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <section class="auth-page">
        <div class="auth-card">
            <div class="card">
                <div class="auth-icon"><i class="fa-solid fa-right-to-bracket"></i></div>
                <h1>{{ 'login.title'|trans }}</h1>
                <p class="lead">{{ 'login.subtitle'|trans }}</p>

                {% if error %}
                    <div class="alert alert-error mb-2" role="alert">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <div>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                            {% if not_verified %}
                                <br><a href="{{ path('app_verify_resend') }}">{{ 'login.resend_verification'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="form-group">
                        <label class="form-label required" for="identifier">{{ 'login.identifier'|trans }}</label>
                        <input type="text" id="identifier" name="identifier" value="{{ last_username }}" class="form-control"
                               autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                        <small class="form-help">{{ 'login.identifier_help'|trans }}</small>
                    </div>
                    <div class="form-group" data-controller="password-toggle" data-password-toggle-show-value="{{ 'a11y.show_password'|trans }}" data-password-toggle-hide-value="{{ 'a11y.hide_password'|trans }}">
                        <label class="form-label required" for="password">{{ 'login.password'|trans }}</label>
                        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                    </div>
                    <div class="cluster mb-2" style="justify-content: space-between">
                        <div class="form-check mb-0">
                            <input type="checkbox" id="remember_me" name="_remember_me" class="form-check-input" checked>
                            <label for="remember_me" class="form-check-label">{{ 'login.remember_me'|trans }}</label>
                        </div>
                        <a class="text-small" href="{{ path('app_forgot_password_request') }}">{{ 'login.forgot'|trans }}</a>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-block btn-lg">{{ 'login.submit'|trans }}</button>
                </form>

                <p class="form-footer">{{ 'login.no_account'|trans }} <a href="{{ path('app_register') }}">{{ 'login.register'|trans }}</a></p>
            </div>
        </div>
    </section>
{% endblock %}
